{
  "canisters": {
    "auth": {
      "main": "src/know_fi_backend/auth/main.mo",
      "type": "motoko"
    },
    "profile": {
      "main": "src/know_fi_backend/profile/src/main.mo",
      "type": "motoko"
    },
    "quiz": {
      "main": "src/know_fi_backend/quiz/src/main.mo",
      "type": "motoko"
    },
    "courses": {
      "main": "src/know_fi_backend/courses/main.mo",
      "type": "motoko",
      "dependencies": ["profile", "auth"]
    },
    "forum": {
      "main": "src/know_fi_backend/forum/main.mo",
      "type": "motoko",
      "dependencies": ["profile"]
    },
    "quests": {
      "main": "src/know_fi_backend/quests/main.mo",
      "type": "motoko"
    },
    "icrc7": {
      "main": "src/know_fi_backend/nft/src/main.mo",
      "type": "motoko"
    },
    "know_fi_frontend": {
      "source": ["src/know_fi_frontend/out"],
      "type": "assets",
      "dependencies": ["profile", "quiz", "auth", "quests", "forum", "courses"]
    },
    "internet_identity": {
      "type": "custom",
      "candid": "https://github.com/dfinity/internet-identity/releases/download/release-2025-04-04-v3/internet_identity.did",
      "wasm": "https://github.com/dfinity/internet-identity/releases/download/release-2025-04-04-v3/internet_identity_dev.wasm.gz",
      "init_arg": "(opt record { captcha_config = opt record { max_unsolved_captchas= 50:nat64; captcha_trigger = variant {Static = variant {CaptchaDisabled}}}})",
      "remote": {
        "id": {
          "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        }
      }
    }
  },
  "networks": {
    "staging": {
      "providers": ["icp0.app"],
      "type": "persistent"
    },
    "local": {
      "type": "ephemeral",
      "bind": "127.0.0.1:4943"
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "output_env_file": ".env",
  "version": 1
}
